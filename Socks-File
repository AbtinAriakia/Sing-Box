{
  "log": {
    "disabled": false,
    "level": "error",
    "output": "/etc/sfolder/sing-box.log",
    "timestamp": true
  },
  "dns": {
    "servers": [
      {
        "type": "local",
        "tag": "local"
      }
    ]
  },
  "route": {
    "rules": [
      {
        "protocol": "quic",
        "action": "reject"
      }
    ]
  },
  "inbounds": [
    {
      "type": "socks",
      "tag": "socks-in",
      "listen": "::",
      "listen_port": ,
      "tcp_fast_open": true,
      "users": [
        {
          "username": "",
          "password": ""
        }
      ]
    }
  ],
  "outbounds": [
    {
      "type": "direct",
      "tag": "direct-out",
      "domain_resolver": {
        "server": "local",
        "strategy": "ipv4_only"
      }
    }
  ]
}
